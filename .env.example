# Copy to .env and fill values. Never commit .env.
# Official developer API keys only. Chat websites cannot be connected.

# OpenAI Platform (or an allowlisted OpenAI-compatible host)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Console
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Gemini API (generativelanguage.googleapis.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: extra HTTPS API hosts you trust (comma-separated)
# Required before a custom OPENAI_BASE_URL host is accepted.
ALLOWED_API_HOSTS=

# Optional official xAI developer API key (https://api.x.ai/v1). Not a grok.com login.
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Optional: path to an already-installed official CLI (never downloaded by this app)
# GROK_CLI_PATH=
# CODEX_CLI_PATH=

# Optional: default routing when "auto"
# Values: auto | openai | anthropic | gemini | xai | grok_cli | codex_cli
DEFAULT_PROVIDER=auto

# Optional: max chars per API call (default 3000)
TRANSLATE_CHUNK_SIZE=3000

# Folder / zip batch caps
MAX_BATCH_FILES=400
MAX_BATCH_BYTES=80000000
