# Copy to .env and fill values. Never commit .env.
# At least one provider key is required for actual translation.

# OpenAI or any OpenAI-compatible endpoint (DeepSeek, Groq, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional: default routing when "auto"
# Values: auto | openai | anthropic
DEFAULT_PROVIDER=auto

# Optional: max chars per chunk (large files are split)
TRANSLATE_CHUNK_SIZE=3000
